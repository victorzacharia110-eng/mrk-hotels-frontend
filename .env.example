# =============================================================================
# MRK Hotels Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local (local dev) or set these in Netlify's UI.
# Vite inlines VITE_* variables at build time — changes require a redeploy.
# =============================================================================

# Backend API base URL (without trailing slash).
# Local dev:    VITE_API_URL=http://localhost:8000/api
# Production:   VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=http://localhost:8000/api

# Laravel Reverb (WebSocket) config for real-time messaging.
# VITE_REVERB_SCHEME=https
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=ws.yourdomain.com
# VITE_REVERB_PORT=443
